# MISTRAL_API_KEY: Required for the AI morning brief punchline.
# Get one at https://console.mistral.ai (free tier is enough).
# Note: the project migrated from Google Gemini to Mistral in July 2026 —
# GEMINI_API_KEY is no longer read anywhere.
MISTRAL_API_KEY="MY_MISTRAL_API_KEY"

# APP_URL: Public URL where the app is hosted.
APP_URL="MY_APP_URL"

# VAPID keys for Web Push. Generate once with:
#   npx web-push generate-vapid-keys
# Same pair must be reused; regenerating invalidates all existing subscriptions.
VAPID_PUBLIC_KEY="MY_VAPID_PUBLIC_KEY"
VAPID_PRIVATE_KEY="MY_VAPID_PRIVATE_KEY"
VAPID_CONTACT="mailto:contact@example.com"

# ADMIN_TOKEN: Secret for admin endpoints (/api/test-push, manual /api/cron/check-weather).
# Generate a long random string. Frontend reads it from localStorage.setItem('adminToken', ...).
ADMIN_TOKEN="change-me-to-a-long-random-string"

# CRON_SECRET: MUST be set manually in Vercel (Production + Preview).
# Both Vercel Cron and the external schedulers call
# /api/cron/check-weather with `Authorization: Bearer $CRON_SECRET`.
# If it is missing, the endpoint returns 401 and NO push is ever sent.
# The same value must also exist as a GitHub Actions repository secret.
CRON_SECRET=""

# Upstash Redis for persistent storage (subscriptions).
# Provision via Vercel Marketplace -> Upstash; env vars are injected automatically:
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
