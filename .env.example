# GEMINI_API_KEY: Required for Gemini AI API calls (Brief Matinal).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VAPID_CONTACT: Contact email for Web Push (used by web-push lib).
# Format: "mailto:you@example.com"
VAPID_CONTACT="mailto:contact@example.com"

# ADMIN_TOKEN: Secret token to authorize admin endpoints
# (/api/cron/check-weather, /api/test-push). Generate a long random string.
# In the frontend, store it via: localStorage.setItem('adminToken', '<value>')
ADMIN_TOKEN="change-me-to-a-long-random-string"
